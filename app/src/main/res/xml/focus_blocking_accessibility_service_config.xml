<?xml version="1.0" encoding="utf-8"?>
<!-- Minimum configuration for FocusBlockingAccessibilityService: only the window-state-changed
     event (needed to detect foreground-app switches) and no window-content retrieval, since this
     service only ever needs the foreground package name, never anything drawn on screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/focus_blocking_accessibility_service_description" />
