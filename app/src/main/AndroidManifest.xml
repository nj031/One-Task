<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Lets Focus Mode's Block Distractions screen enumerate the device's other launchable apps
         (icon/name only, to build the block-list UI - see InstalledAppsRepository) without the
         restricted, Play-Store-discouraged QUERY_ALL_PACKAGES permission. Android 11+ hides
         package visibility by default unless the target apps match a declared <queries> filter;
         this is the standard, minimal filter for "any app with a launcher icon". No runtime
         permission prompt is involved. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneTask">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OneTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started focus timer counting down accurately, with a persistent notification, while the app is backgrounded or the screen is locked." />
        </service>

        <service
            android:name=".service.StandaloneTimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started Timer countdown or Stopwatch counting accurately, with a persistent notification, while the app is backgrounded or the screen is locked." />
        </service>

        <receiver
            android:name=".data.reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.reminder.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Grants the system Camera app permission to write a captured note photo directly into
             this app's own private storage (see NoteImageStorage.createCaptureUri) - the standard
             Android mechanism for handing another app a writable content:// Uri into a directory
             this app doesn't otherwise expose. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
